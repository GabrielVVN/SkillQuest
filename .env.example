# Arquivo de exemplo para variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores

# Chave secreta para sessões Flask (gere uma chave segura)
SECRET_KEY=skillquest_super_secret_key_123

# Configurações do banco de dados
DATABASE_URL=sqlite:///skillquest.db

# Configurações do Flask
FLASK_ENV=production
FLASK_DEBUG=False

# Porta do servidor (Render define automaticamente)
PORT=5000